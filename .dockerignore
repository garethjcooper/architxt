database/
documents/
logs/
tmp/

# Environment / secrets
.env
.env.local
.env.*.local
server/.env
server/.env.local

# Git / CI
.gitignore
.github/
.gitattributes

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/
.nyc_output/

# Misc
*.md
docs/
scripts/__pycache__/
scripts/*.pyc
